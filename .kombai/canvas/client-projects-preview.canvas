        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Syne:wght@600;700;800&display=swap');\n\n  .client-preview {\n    --ink: #ededed;\n    --muted: rgba(237, 237, 237, 0.46);\n    --surface: #0d0e12;\n    --tray: #16171d;\n    --aaa-blue: #214a9b;\n    --aaa-gold: #d6ad27;\n    --gst-ochre: #c9a04e;\n    --gst-blush: #f8eee6;\n    position: relative;\n    min-height: 100%;\n    overflow: hidden;\n    background: #000;\n    color: var(--ink);\n    font-family: 'Inter', sans-serif;\n  }\n\n  .client-preview::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 18%;\n    right: 7%;\n    pointer-events: none;\n    opacity: 0.08;\n    background-image: linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);\n    background-size: 60px 60px;\n    mask-image: linear-gradient(to bottom, transparent 0, black 7%, black 92%, transparent 100%);\n  }\n\n  .client-shell {\n    position: relative;\n    z-index: 1;\n    width: min(1180px, calc(100% - 96px));\n    margin: 0 auto;\n    padding: 116px 0 150px;\n  }\n\n  .client-header {\n    display: grid;\n    grid-template-columns: 18% 1fr;\n    gap: 52px;\n    align-items: start;\n    margin-bottom: 58px;\n  }\n\n  .client-rail {\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n    padding-top: 8px;\n    color: rgba(237,237,237,0.42);\n    font: 700 11px/1.4 'Space Mono', monospace;\n    letter-spacing: 0.14em;\n  }\n\n  .client-counter {\n    display: grid;\n    place-items: center;\n    width: 38px;\n    height: 38px;\n    border: 1px solid rgba(255,255,255,0.24);\n    border-radius: 50%;\n    color: rgba(237,237,237,0.78);\n    font-size: 12px;\n    letter-spacing: 0;\n  }\n\n  .client-heading {\n    margin: 0;\n    max-width: 760px;\n    overflow-wrap: anywhere;\n    font: 800 clamp(58px, 6.8vw, 104px)/0.96 'Syne', sans-serif;\n    letter-spacing: -0.045em;\n    text-transform: uppercase;\n  }\n\n  .client-subtitle {\n    max-width: 510px;\n    margin: 25px 0 0;\n    color: rgba(237,237,237,0.56);\n    font-size: 17px;\n    line-height: 1.65;\n  }\n\n  .route-line {\n    position: relative;\n    width: min(700px, 100%);\n    height: 18px;\n    margin-top: 35px;\n    border-top: 1px solid rgba(255,255,255,0.22);\n  }\n\n  .route-line::before {\n    content: '';\n    position: absolute;\n    top: -2px;\n    left: 0;\n    width: 39%;\n    height: 3px;\n    background: linear-gradient(90deg, var(--aaa-blue), var(--aaa-gold));\n    transform-origin: left;\n  }\n\n  .route-line::after {\n    content: '';\n    position: absolute;\n    top: -5px;\n    left: 39%;\n    width: 8px;\n    height: 8px;\n    border: 1px solid var(--aaa-gold);\n    border-radius: 50%;\n    background: #000;\n  }\n\n  .deployment-record {\n    position: relative;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,0.14);\n    border-top-left-radius: 28px;\n    border-bottom-right-radius: 28px;\n    border-top-right-radius: 7px;\n    border-bottom-left-radius: 7px;\n    background: var(--surface);\n  }\n\n  .deployment-record.aaa { border-color: rgba(33,74,155,0.5); }\n  .deployment-record.prime { border-color: rgba(201,160,78,0.42); }\n\n  .registration {\n    position: absolute;\n    z-index: 3;\n    width: 15px;\n    height: 15px;\n    opacity: 0.7;\n    pointer-events: none;\n  }\n\n  .registration::before,\n  .registration::after {\n    content: '';\n    position: absolute;\n    background: currentColor;\n  }\n\n  .registration::before { width: 15px; height: 1px; }\n  .registration::after { width: 1px; height: 15px; }\n  .registration.top-left { top: 18px; left: 18px; color: var(--aaa-gold); }\n  .registration.top-left::after { top: 0; left: 0; }\n  .registration.bottom-right { right: 18px; bottom: 18px; color: var(--aaa-gold); transform: rotate(180deg); }\n  .prime .registration.top-left,\n  .prime .registration.bottom-right { color: var(--gst-ochre); }\n\n  .record-meta {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    flex-wrap: wrap;\n    padding: 27px 34px 22px;\n    border-bottom: 1px solid rgba(255,255,255,0.09);\n    color: rgba(237,237,237,0.66);\n    font: 700 11px/1.45 'Space Mono', monospace;\n    letter-spacing: 0.08em;\n  }\n\n  .record-meta span:first-child { color: rgba(237,237,237,0.9); }\n  .record-meta span + span::before { content: '·'; margin-right: 18px; color: rgba(255,255,255,0.2); }\n\n  .record-grid {\n    display: grid;\n    grid-template-columns: 38% 62%;\n    min-height: 540px;\n  }\n\n  .record-copy {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    padding: 46px 32px 50px 34px;\n  }\n\n  .record-index {\n    margin-bottom: 15px;\n    color: rgba(237,237,237,0.58);\n    font: 700 11px 'Space Mono', monospace;\n    letter-spacing: 0.1em;\n  }\n\n  .record-title {\n    margin: 0;\n    color: var(--ink);\n    font: 800 clamp(30px, 3vw, 48px)/0.98 'Syne', sans-serif;\n    letter-spacing: -0.055em;\n  }\n\n  .record-descriptor {\n    margin: 11px 0 0;\n    color: var(--aaa-gold);\n    font: 700 12px/1.4 'Space Mono', monospace;\n    letter-spacing: 0.04em;\n  }\n\n  .prime .record-descriptor { color: var(--gst-ochre); }\n\n  .record-description {\n    max-width: 330px;\n    margin: 20px 0 25px;\n    color: rgba(237,237,237,0.58);\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .destination-plate {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    width: 100%;\n    min-height: 55px;\n    padding: 0 16px 0 18px;\n    border: 0;\n    border-radius: 8px;\n    background: var(--aaa-gold);\n    color: #15130a;\n    text-decoration: none;\n    font-size: 13px;\n    font-weight: 700;\n    transition: background-color 180ms ease;\n    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);\n  }\n\n  .destination-plate:hover { background: #e3c34a; }\n  .destination-plate:focus-visible { outline: 2px solid var(--aaa-gold); outline-offset: 3px; }\n  .destination-plate .arrow { font-size: 21px; line-height: 1; transition: transform 180ms ease; }\n  .destination-plate:hover .arrow { transform: translate(3px, -3px); }\n\n  .plate-note {\n    margin: 10px 0 0;\n    color: rgba(237,237,237,0.56);\n    font-size: 12px;\n  }\n\n  .record-url {\n    margin: 10px 0 31px;\n    color: rgba(237,237,237,0.63);\n    font: 11px 'Space Mono', monospace;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .record-url:hover { color: var(--aaa-gold); }\n\n  .capability-label {\n    margin: auto 0 12px;\n    color: rgba(237,237,237,0.58);\n    font: 700 11px 'Space Mono', monospace;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n\n  .capability-list {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 9px 16px;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n    color: rgba(237,237,237,0.68);\n    font-size: 12px;\n    line-height: 1.3;\n  }\n\n  .capability-list li::before { content: '↗'; margin-right: 8px; color: var(--aaa-gold); }\n\n  .record-preview {\n    position: relative;\n    display: flex;\n    align-items: center;\n    min-width: 0;\n    padding: 28px 30px 34px 20px;\n    background: rgba(22,23,29,0.75);\n  }\n\n  .preview-tray {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    min-height: 446px;\n    padding: 12px;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,0.08);\n    background: #08090c;\n  }\n\n  .preview-main {\n    display: block;\n    width: 100%;\n    height: 100%;\n    min-height: 420px;\n    object-fit: cover;\n    object-position: 50% 15%;\n    border-radius: 12px;\n    opacity: 0.92;\n  }\n\n  .preview-overlay {\n    position: absolute;\n    top: 26px;\n    right: 25px;\n    bottom: 58px;\n    width: 23%;\n    overflow: hidden;\n    border: 1px solid var(--aaa-gold);\n    border-radius: 4px;\n    background: #0d0e12;\n  }\n\n  .preview-overlay img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: 100% 8%;\n    opacity: 0.9;\n  }\n\n  .preview-caption {\n    position: absolute;\n    right: 12px;\n    bottom: 12px;\n    left: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    min-height: 37px;\n    padding: 0 12px;\n    background: rgba(4,5,7,0.84);\n    color: rgba(255,255,255,0.68);\n    font: 10px 'Space Mono', monospace;\n    letter-spacing: 0.12em;\n  }\n\n  .preview-route {\n    position: absolute;\n    right: 25px;\n    bottom: 17px;\n    left: 25px;\n    height: 2px;\n    background: linear-gradient(90deg, var(--aaa-blue) 0 78%, var(--aaa-gold) 78% 100%);\n  }\n\n  .preview-route::after {\n    content: '';\n    position: absolute;\n    top: -5px;\n    right: 0;\n    width: 11px;\n    height: 11px;\n    border: 1px solid var(--aaa-gold);\n    border-radius: 50%;\n    background: #08090c;\n  }\n\n  .record-separator {\n    height: 72px;\n    background: #000;\n  }\n\n  .prime .record-grid {\n    grid-template-columns: 58% 42%;\n  }\n\n  .prime .record-preview {\n    order: 1;\n    padding: 30px 20px 34px 30px;\n  }\n\n  .prime .record-copy {\n    order: 2;\n    justify-content: center;\n    padding: 44px 34px 52px 30px;\n  }\n\n  .prime .preview-main {\n    min-height: 414px;\n    object-position: 49% 12%;\n    border-radius: 10px;\n  }\n\n  .prime .preview-overlay {\n    top: auto;\n    right: auto;\n    bottom: 53px;\n    left: 25px;\n    width: 29%;\n    height: 40%;\n    border-color: var(--gst-ochre);\n  }\n\n  .prime .preview-overlay img { object-position: 15% 58%; }\n  .prime .preview-caption { left: 12px; }\n  .prime .record-description { margin-bottom: 27px; }\n  .prime .destination-plate {\n    width: min(100%, 280px);\n    background: var(--gst-blush);\n    color: #27231f;\n    clip-path: none;\n    border-left: 3px solid var(--gst-ochre);\n  }\n  .prime .destination-plate:hover { background: #fff8f1; }\n  .prime .destination-plate:focus-visible { outline-color: var(--gst-ochre); }\n  .prime .record-url { margin-bottom: 35px; }\n  .prime .record-url:hover { color: var(--gst-ochre); }\n  .prime .capability-list { display: flex; flex-direction: column; gap: 11px; }\n  .prime .capability-list li::before { color: var(--gst-ochre); }\n\n  .ledger-scale {\n    position: absolute;\n    right: 30px;\n    bottom: 18px;\n    left: 30px;\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    height: 12px;\n    opacity: 0.8;\n  }\n\n  .ledger-scale span {\n    width: 1px;\n    height: 7px;\n    background: var(--gst-ochre);\n  }\n\n  .ledger-scale span:nth-child(3) { height: 12px; }\n\n  @media (max-width: 768px) {\n    .client-preview::before { left: 8%; right: 5%; }\n    .client-shell { width: calc(100% - 48px); padding: 66px 0 90px; }\n    .client-header { display: block; margin-bottom: 38px; }\n    .client-rail { flex-direction: row; align-items: center; gap: 14px; padding: 0; margin-bottom: 22px; }\n    .client-counter { width: 30px; height: 30px; font-size: 10px; }\n    .client-heading { font-size: clamp(46px, 13vw, 60px); line-height: 0.98; letter-spacing: -0.035em; }\n    .client-subtitle { margin-top: 18px; font-size: 14px; }\n    .route-line { margin-top: 25px; }\n    .record-meta { gap: 8px 14px; padding: 23px 22px 18px; font-size: 10px; }\n    .record-meta span + span::before { margin-right: 12px; }\n    .record-grid, .prime .record-grid { display: flex; flex-direction: column; }\n    .record-copy, .prime .record-copy { order: 1; padding: 34px 22px 32px; }\n    .record-preview, .prime .record-preview { order: 2; padding: 0 15px 25px; }\n    .record-title { font-size: 35px; }\n    .record-description { font-size: 13px; margin: 17px 0 20px; }\n    .destination-plate, .prime .destination-plate { width: 100%; min-height: 53px; }\n    .record-url, .prime .record-url { margin-bottom: 27px; }\n    .capability-label { margin-top: 29px; }\n    .capability-list { grid-template-columns: 1fr; gap: 10px; }\n    .preview-tray { min-height: 300px; height: 300px; padding: 8px; }\n    .preview-main, .prime .preview-main { min-height: 284px; }\n    .preview-overlay { top: 18px; right: 18px; bottom: 45px; width: 38%; }\n    .prime .preview-overlay { right: auto; bottom: 43px; left: 18px; width: 38%; height: 42%; }\n    .preview-caption { right: 8px; bottom: 8px; left: 8px; min-height: 31px; padding: 0 8px; font-size: 10px; letter-spacing: 0.05em; }\n    .preview-route { right: 18px; bottom: 13px; left: 18px; }\n    .ledger-scale { right: 18px; bottom: 14px; left: 18px; }\n    .record-separator { height: 44px; }\n  }\n</style>\n<section class=\"client-preview\" data-kid=\"1\" data-name=\"page layout container\" id=\"clients\">\n    <div class=\"client-shell\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <header class=\"client-header\" data-kid=\"1-1-1\" data-name=\"client header section\">\n            <div class=\"client-rail\" data-kid=\"1-1-1-1\" data-name=\"client work rail container\">\n                <span data-kid=\"1-1-1-1-1\" data-name=\"client work label\">\n                    // CLIENT WORK\n                </span>\n                <span aria-label=\"Two client deployments\" class=\"client-counter\" data-kid=\"1-1-1-1-2\" data-name=\"client deployments counter\">\n                    02\n                </span>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"client title block\">\n                <h2 class=\"client-heading\" data-kid=\"1-1-1-2-1\" data-name=\"client deployments heading\">\n                    Client\n                    <br class=\"hidden md:block\" data-kid=\"1-1-1-2-1-1\" data-name=\"line break\"/>\n                    Deployments\n                </h2>\n                <p class=\"client-subtitle\" data-kid=\"1-1-1-2-2\" data-name=\"client subtitle text\">\n                    Two production websites built for organisations in Odisha.\n                </p>\n                <div aria-hidden=\"true\" class=\"route-line\" data-kid=\"1-1-1-2-3\" data-name=\"decorative route line\">\n                </div>\n            </div>\n        </header>\n        <article class=\"deployment-record aaa\" data-kid=\"1-1-2\" data-name=\"aaa deployment record card\">\n            <span aria-hidden=\"true\" class=\"registration top-left\" data-kid=\"1-1-2-1\" data-name=\"top-left registration corner mark\">\n            </span>\n            <span aria-hidden=\"true\" class=\"registration bottom-right\" data-kid=\"1-1-2-2\" data-name=\"bottom-right registration corner mark\">\n            </span>\n            <div class=\"record-meta\" data-kid=\"1-1-2-3\" data-name=\"aaa record meta information container\">\n                <span data-kid=\"1-1-2-3-1\" data-name=\"aaa project sequence label\">\n                    01 / PRODUCTION WEBSITE\n                </span>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"aaa client name\">\n                    ARYAVART ANCIENT ACADEMY\n                </span>\n                <span data-kid=\"1-1-2-3-3\" data-name=\"aaa client location\">\n                    KHORDHA, ODISHA\n                </span>\n            </div>\n            <div class=\"record-grid\" data-kid=\"1-1-2-4\" data-name=\"aaa record grid\">\n                <div class=\"record-copy\" data-kid=\"1-1-2-4-1\" data-name=\"aaa record details container\">\n                    <span class=\"record-index\" data-kid=\"1-1-2-4-1-1\" data-name=\"aaa deployment index label\">\n                        DEPLOYMENT 01\n                    </span>\n                    <h3 class=\"record-title\" data-kid=\"1-1-2-4-1-2\" data-name=\"aaa project title\">\n                        Aryavart\n                        <br data-kid=\"1-1-2-4-1-2-1\" data-name=\"line break\"/>\n                        Ancient Academy\n                    </h3>\n                    <p class=\"record-descriptor\" data-kid=\"1-1-2-4-1-3\" data-name=\"aaa record descriptor text\">\n                        AAA Alumni Portal\n                    </p>\n                    <p class=\"record-description\" data-kid=\"1-1-2-4-1-4\" data-name=\"aaa project description text\">\n                        An alumni portal for reconnecting graduates through directory, events, achievements, gallery and notifications.\n                    </p>\n                    <a class=\"destination-plate\" data-kid=\"1-1-2-4-1-5\" data-name=\"aaa visit website button\" href=\"https://aaalumni.com/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        <span data-kid=\"1-1-2-4-1-5-1\" data-name=\"visit website button text\">\n                            Visit AAA Alumni Portal\n                        </span>\n                        <span aria-hidden=\"true\" class=\"arrow\" data-kid=\"1-1-2-4-1-5-2\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <span class=\"plate-note\" data-kid=\"1-1-2-4-1-6\" data-name=\"visit website button note text\">\n                        Opens the live website\n                    </span>\n                    <a class=\"record-url\" data-kid=\"1-1-2-4-1-7\" data-name=\"aaa project website URL\" href=\"https://aaalumni.com/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        aaalumni.com\n                    </a>\n                    <span class=\"capability-label\" data-kid=\"1-1-2-4-1-8\" data-name=\"aaa capability list label\">\n                        Coverage\n                    </span>\n                    <ul class=\"capability-list\" data-kid=\"1-1-2-4-1-9\" data-name=\"aaa capability list\">\n                        <li data-kid=\"1-1-2-4-1-9-1\" data-name=\"aaa capability list item\">\n                            Alumni directory\n                        </li>\n                        <li data-kid=\"1-1-2-4-1-9-2\" data-name=\"aaa capability list item\">\n                            Events\n                        </li>\n                        <li data-kid=\"1-1-2-4-1-9-3\" data-name=\"aaa capability list item\">\n                            Achievements\n                        </li>\n                        <li data-kid=\"1-1-2-4-1-9-4\" data-name=\"aaa capability list item\">\n                            Gallery\n                        </li>\n                        <li data-kid=\"1-1-2-4-1-9-5\" data-name=\"aaa capability list item\">\n                            Notifications\n                        </li>\n                        <li data-kid=\"1-1-2-4-1-9-6\" data-name=\"aaa capability list item\">\n                            Portal login\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"record-preview\" data-kid=\"1-1-2-4-2\" data-name=\"aaa project preview container\">\n                    <div class=\"preview-tray\" data-kid=\"1-1-2-4-2-1\" data-name=\"aaa preview tray\">\n                        <img alt=\"AAA Alumni Portal homepage showing campus aerial view, academy crest, alumni network call to action and alumni statistics.\" class=\"preview-main\" data-kid=\"1-1-2-4-2-1-1\" data-name=\"aaa website preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aaa-alumni-live-preview.jpeg\"/>\n                        <div aria-hidden=\"true\" class=\"preview-overlay\" data-kid=\"1-1-2-4-2-1-2\" data-name=\"aaa preview overlay window\">\n                            <img alt=\"\" data-kid=\"1-1-2-4-2-1-2-1\" data-name=\"aaa preview overlay image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aaa-alumni-live-preview.jpeg\"/>\n                        </div>\n                        <div class=\"preview-caption\" data-kid=\"1-1-2-4-2-1-3\" data-name=\"aaa preview caption container\">\n                            <span data-kid=\"1-1-2-4-2-1-3-1\" data-name=\"aaa preview status text\">\n                                LIVE SITE PREVIEW / HOME\n                            </span>\n                            <span data-kid=\"1-1-2-4-2-1-3-2\" data-name=\"aaa preview code identifier\" style=\"color: #d6ad27;\">\n                                AAA / 01\n                            </span>\n                        </div>\n                        <div aria-hidden=\"true\" class=\"preview-route\" data-kid=\"1-1-2-4-2-1-4\" data-name=\"aaa preview route line\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </article>\n        <div aria-hidden=\"true\" class=\"record-separator\" data-kid=\"1-1-3\" data-name=\"deployment record separator\">\n        </div>\n        <article class=\"deployment-record prime\" data-kid=\"1-1-4\" data-name=\"prime gst deployment record card\">\n            <span aria-hidden=\"true\" class=\"registration top-left\" data-kid=\"1-1-4-1\" data-name=\"top-left registration corner mark\">\n            </span>\n            <span aria-hidden=\"true\" class=\"registration bottom-right\" data-kid=\"1-1-4-2\" data-name=\"bottom-right registration corner mark\">\n            </span>\n            <div class=\"record-meta\" data-kid=\"1-1-4-3\" data-name=\"prime record meta information container\">\n                <span data-kid=\"1-1-4-3-1\" data-name=\"prime project sequence label\">\n                    02 / PRODUCTION WEBSITE\n                </span>\n                <span data-kid=\"1-1-4-3-2\" data-name=\"prime client name\">\n                    PRIME GST MITRA\n                </span>\n                <span data-kid=\"1-1-4-3-3\" data-name=\"prime client location\">\n                    BHUBANESWAR, ODISHA\n                </span>\n            </div>\n            <div class=\"record-grid\" data-kid=\"1-1-4-4\" data-name=\"prime record grid\">\n                <di